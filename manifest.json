{
  "manifest_version": 3,
  "name": "YouTube Stats",
  "version": "1.0",
  "description": "Track your YouTube watch time across videos and sessions. Monitors playback in real-time, scrapes your watch history with progress bars, and syncs your data across devices via Chrome Sync.",
  "permissions": ["activeTab", "storage", "syncStorage", "declarativeNetRequest"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["storage.js", "watch.js"]
    },
    {
      "matches": ["*://*.youtube.com/feed/history*"],
      "js": ["storage.js", "history.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
