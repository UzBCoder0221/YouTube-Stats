{
  "manifest_version": 3,
  "name": "YouTube stats",
  "version": "1.0",
  "description": "...",
  "permissions": ["activeTab", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon.png"
  },
  "content_scripts": [{
    "matches": ["*://*.youtube.com/watch*"],
    "js": ["content.js"]
  }],
  "background": {
    "service_worker": "background.js"
  }
}